# TEMPLATE ONLY. Do not commit a secrets.toml containing real credentials.
# For deployment, replace the placeholders and paste into the hosting Secrets UI.
DEMO_MODE = false
BUILDING_NAME = "Nhà trọ An Nhiên"
ADMIN_USERNAME = "chu-tro"
ADMIN_PASSWORD_HASH = "REPLACE_WITH_OUTPUT_OF_hash_password.py"

# Copy the Session pooler URL from Supabase > Connect.
# Use its exact host/user, percent-encode the password, and require SSL.
DATABASE_URL = "postgresql+psycopg://ROLE.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Optional. Empty means labelled demo fallback; no Gemini call is made.
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"
