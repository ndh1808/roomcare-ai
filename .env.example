# Local demo. Copy to .env; never commit .env.
DEMO_MODE=true
BUILDING_NAME="Nhà trọ An Nhiên"
DATABASE_URL=sqlite:///data/roomcare.db

# Optional: leave empty for clearly labelled demo analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# For real deployment: set DEMO_MODE=false, replace DATABASE_URL with a
# shared PostgreSQL connection, and fill in your own admin credentials.
ADMIN_USERNAME=chu-tro
# Generate locally: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
